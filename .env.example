# Copy this file to .env for local development.
# Do not put real secrets in this file or commit a populated .env file.
# Component-specific variables will be documented with each component.
POSTGRES_DB=adoptajob
POSTGRES_USER=adoptajob
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://adoptajob:change-me-local-only@localhost:5432/adoptajob?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
MATCHING_SERVICE_URL=http://matching:4000
MATCHING_SERVICE_API_KEY=replace-with-at-least-16-local-characters
